# =========================================================
# Default text normalization
# =========================================================
* text=auto
# =========================================================
# Unreal Engine C++ source files - LF
# =========================================================
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.inl text eol=lf
# =========================================================
# Unreal Engine project and configuration files - LF
# =========================================================
*.uproject filter=lfs diff=lfs merge=lfs -text
*.uplugin text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# =========================================================
# Documentation and scripts - LF
# =========================================================
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.sh text eol=lf
# =========================================================
# Windows scripts - CRLF
# =========================================================
*.bat text eol=crlf
*.cmd text eol=crlf
# =========================================================
# Visual Studio project files - CRLF
# =========================================================
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
# =========================================================
# Unreal Engine binary assets
# =========================================================
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
# =========================================================
# Images and media
# =========================================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.mp4 binary
*.mov binary
*.avi binary
*.fbx binary
*.obj binary
*.blend binary
*.psd binary
